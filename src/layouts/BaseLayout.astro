---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Three formats, in the order browsers should try them: ico as the
      universal fallback, svg for browsers that support it (preferred when
      both are present), png as a fallback for browsers that support
      neither (e.g. Safari's spotty SVG favicon support). The ?v=2 query
      busts favicon caches, which browsers keep separately from normal HTTP
      caching and don't always revalidate on a redeploy.
    -->
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!--
      Set the language before first paint to avoid a flash of the wrong
      language: reuse the visitor's previous explicit choice, or fall back
      to their browser/OS language on the first visit.
    -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("lang");
        var lang;
        if (stored === "es" || stored === "en") {
          lang = stored;
        } else {
          var browserLang = (navigator.language || "en").toLowerCase();
          lang = browserLang.indexOf("es") === 0 ? "es" : "en";
        }
        document.documentElement.setAttribute("lang", lang);
        document.documentElement.setAttribute("data-lang", lang);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
