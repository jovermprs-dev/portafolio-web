---
import type { Content, Lang } from "../i18n/content";

interface Props {
  lang: Lang;
  education: Content["education"];
}

const { lang, education } = Astro.props;
---

<section id={`education-${lang}`} class="education wrapper">
  <h2>{education.heading}</h2>
  {
    education.entries.map((entry) => (
      <div class="education__entry">
        <h3>{entry.title}</h3>
        <p>
          {entry.school} · {entry.period}
        </p>
      </div>
    ))
  }
  <div class="languages">
    <strong>{education.languagesLabel}:</strong> {education.languages.join(" · ")}
  </div>
</section>
