---
import type { Content, Lang } from "../i18n/content";

interface Props {
  lang: Lang;
  nav: Content["nav"];
}

const { lang, nav } = Astro.props;
---

<header class="nav">
  <div class="nav__inner">
    <ul class="nav__links">
      <li><a href="#about">{nav.about}</a></li>
      <li><a href="#experience">{nav.experience}</a></li>
      <li><a href="#skills">{nav.skills}</a></li>
      <li><a href="#projects">{nav.projects}</a></li>
      <li><a href="#contact">{nav.contact}</a></li>
    </ul>
    <button type="button" class="lang-toggle" data-lang-toggle data-current-lang={lang}>
      {nav.langSwitchLabel}
    </button>
  </div>
</header>
