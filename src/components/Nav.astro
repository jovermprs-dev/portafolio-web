---
import type { Content, Lang } from "../i18n/content";

interface Props {
  lang: Lang;
  nav: Content["nav"];
}

const { lang, nav } = Astro.props;
---

<header class="nav">
  <div class="nav__inner">
    <ul class="nav__links">
      <li><a href="#about">{nav.about}</a></li>
      <li><a href="#experience">{nav.experience}</a></li>
      <li><a href="#skills">{nav.skills}</a></li>
      <li><a href="#projects">{nav.projects}</a></li>
      <li><a href="#contact">{nav.contact}</a></li>
    </ul>
    <button
      type="button"
      class="lang-switch"
      data-lang-toggle
      role="switch"
      aria-checked={lang === "es"}
      aria-label={nav.langSwitchLabel}
    >
      <span class="lang-switch__flag" aria-hidden="true">🇬🇧</span>
      <span class="lang-switch__track">
        <span class="lang-switch__thumb"></span>
      </span>
      <span class="lang-switch__flag" aria-hidden="true">🇪🇸</span>
    </button>
  </div>
</header>
