---
import type { Content, Lang } from "../i18n/content";

interface Props {
  lang: Lang;
  projects: Content["projects"];
}

const { lang, projects } = Astro.props;
---

<section id={`projects-${lang}`} class="projects wrapper">
  <h2>{projects.heading}</h2>
  <p class="projects__subheading">{projects.subheading}</p>
  <div class="projects__grid">
    {
      projects.cards.map((card) => (
        <div class:list={["project-card", { "project-card--live": card.url }]}>
          <span class:list={["project-card__badge", { "project-card__badge--live": card.url }]}>
            {card.url ? projects.live : projects.comingSoon}
          </span>
          <h3>{card.name}</h3>
          <p>{card.description}</p>
          {card.url && (
            <a class="btn btn--secondary project-card__link" href={card.url} target="_blank" rel="noopener noreferrer">
              {card.linkLabel} ↗
            </a>
          )}
        </div>
      ))
    }
  </div>
</section>
